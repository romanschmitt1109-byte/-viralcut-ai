# ---- Obligatoire en production ------------------------------------------------
APP_ENV=production
# Générez une valeur longue et aléatoire : python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- Base de données (docker-compose la définit pour vous) --------------------
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/viralcut
# Développement sans Postgres : DATABASE_URL=sqlite:///./viralcut.db

# ---- Transcription ------------------------------------------------------------
# faster_whisper : modèle local (téléchargé depuis Hugging Face au 1er usage)
# openai         : API OpenAI (nécessite OPENAI_API_KEY)
TRANSCRIPTION_PROVIDER=faster_whisper
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 recommandé sur CPU
WHISPER_COMPUTE_TYPE=default

# ---- Sélection des passages ---------------------------------------------------
# auto = Anthropic si clé, sinon OpenAI si clé, sinon heuristique (sans IA générative)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- YouTube (métadonnées uniquement, facultatif : ajoute la durée) -----------
YOUTUBE_API_KEY=

# ---- Stockage -----------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=eu-west-3
# pour MinIO / Scaleway / OVH / R2
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Rendu & file de tâches ---------------------------------------------------
X264_PRESET=veryfast
X264_CRF=20
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER_S=120

# ---- Suivi des coûts (EUR, estimations à ajuster) -----------------------------
COST_PER_ASR_MINUTE=0.006
COST_PER_1K_LLM_INPUT=0.003
COST_PER_1K_LLM_OUTPUT=0.015
